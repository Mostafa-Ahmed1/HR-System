@model IEnumerable<HR_System.Models.AttDep>

@{
    ViewData["Title"] = "Dashboard";
    var attendanceRecords = Model?.ToList() ?? [];
    var employeeCount = attendanceRecords.Select(item => item.EmpId).Distinct().Count();
    var todayCount = attendanceRecords.Count(item => item.Date.Date == DateTime.Today);
    var latestDate = attendanceRecords.Count == 0 ? (DateTime?)null : attendanceRecords.Max(item => item.Date);
    string Initial(string? value) => string.IsNullOrWhiteSpace(value) ? "U" : value[..1].ToUpperInvariant();
}

<section class="hr-page-heading" aria-labelledby="dashboard-title">
    <div>
        <span class="hr-eyebrow">Overview</span>
        <h1 id="dashboard-title">Dashboard</h1>
        <p>Keep track of the latest attendance activity across your organization.</p>
    </div>
</section>

<section class="hr-kpi-grid" aria-label="Attendance summary">
    <article class="hr-kpi-card">
        <div class="hr-kpi-card__icon hr-kpi-card__icon--blue"><i class="fa fa-clock-o" aria-hidden="true"></i></div>
        <div><span class="hr-kpi-card__label">Attendance records</span><strong>@attendanceRecords.Count</strong><small>All recorded entries</small></div>
    </article>
    <article class="hr-kpi-card">
        <div class="hr-kpi-card__icon hr-kpi-card__icon--violet"><i class="fa fa-users" aria-hidden="true"></i></div>
        <div><span class="hr-kpi-card__label">Employees tracked</span><strong>@employeeCount</strong><small>Unique employees in records</small></div>
    </article>
    <article class="hr-kpi-card">
        <div class="hr-kpi-card__icon hr-kpi-card__icon--green"><i class="fa fa-calendar-check-o" aria-hidden="true"></i></div>
        <div><span class="hr-kpi-card__label">Today's entries</span><strong>@todayCount</strong><small>Records dated today</small></div>
    </article>
    <article class="hr-kpi-card">
        <div class="hr-kpi-card__icon hr-kpi-card__icon--amber"><i class="fa fa-history" aria-hidden="true"></i></div>
        <div><span class="hr-kpi-card__label">Latest record</span><strong class="hr-kpi-card__date">@(latestDate?.ToString("dd MMM yyyy") ?? "—")</strong><small>Most recent attendance date</small></div>
    </article>
</section>

<section class="hr-panel" aria-labelledby="recent-attendance-title">
    <div class="hr-panel__header">
        <div><span class="hr-eyebrow">Activity</span><h2 id="recent-attendance-title">Recent attendance</h2></div>
        <span class="hr-panel__count">@attendanceRecords.Count records</span>
    </div>
    <div class="hr-table-wrap">
        <table class="table hr-table">
            <thead>
                <tr><th>Employee</th><th>Date</th><th>Attendance</th><th>Departure</th></tr>
            </thead>
            <tbody>
            @if (attendanceRecords.Count == 0)
            {
                <tr><td colspan="4" class="hr-empty-state">No attendance records have been recorded yet.</td></tr>
            }
            else
            {
                @foreach (var item in attendanceRecords.OrderByDescending(item => item.Date).Take(10))
                {
                    <tr>
                        <td><span class="hr-table-person"><span class="hr-table-person__avatar">@Initial(item.Emp?.EmpName)</span><span>@(item.Emp?.EmpName ?? "Unknown employee")</span></span></td>
                        <td>@item.Date.ToShortDateString()</td>
                        <td>@item.Attendance</td>
                        <td>@item.Departure</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

