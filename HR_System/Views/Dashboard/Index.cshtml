@model IEnumerable<HR_System.Models.AttDep>

@{
    ViewData["Title"] = "Dashboard";
    var records = Model?.ToList() ?? [];
    var employees = records.Select(x => x.EmpId).Distinct().Count();
    var today = records.Count(x => x.Date.Date == DateTime.Today);
    var latest = records.Count == 0 ? (DateTime?)null : records.Max(x => x.Date);
}

<section class="sneat-page-heading">
    <div><span class="text-primary text-uppercase small fw-semibold">Overview</span><h2 class="fw-bold mb-1">Dashboard</h2><p class="text-muted mb-0">A clear view of your latest attendance activity.</p></div>
</section>

<section class="row g-4 mb-4" aria-label="Attendance summary">
    <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><span class="kpi-icon kpi-icon-primary"><i class="fa fa-clock-o" aria-hidden="true"></i></span><span class="text-muted small">All time</span></div><h3 class="mb-1 mt-3">@records.Count</h3><span class="text-muted">Attendance records</span></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><span class="kpi-icon kpi-icon-info"><i class="fa fa-users" aria-hidden="true"></i></span><span class="text-muted small">Unique</span></div><h3 class="mb-1 mt-3">@employees</h3><span class="text-muted">Employees tracked</span></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><span class="kpi-icon kpi-icon-success"><i class="fa fa-calendar-check-o" aria-hidden="true"></i></span><span class="text-muted small">Today</span></div><h3 class="mb-1 mt-3">@today</h3><span class="text-muted">Today's entries</span></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><span class="kpi-icon kpi-icon-warning"><i class="fa fa-history" aria-hidden="true"></i></span><span class="text-muted small">Latest</span></div><h3 class="mb-1 mt-3">@((latest?.ToString("dd MMM yyyy")) ?? "—")</h3><span class="text-muted">Most recent date</span></div></div></div>
</section>

<section class="card" aria-labelledby="recent-attendance-title">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2"><div><span class="text-primary text-uppercase small fw-semibold">Activity</span><h5 id="recent-attendance-title" class="mb-0 mt-1">Recent attendance</h5></div><span class="badge bg-label-primary">@records.Count records</span></div>
    <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Employee</th><th>Date</th><th>Attendance</th><th>Departure</th></tr></thead><tbody>
    @if (records.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-5">No attendance records have been recorded yet.</td></tr> }
    else { @foreach (var item in records.OrderByDescending(x => x.Date).Take(10)) { <tr><td>@(item.Emp?.EmpName ?? "Unknown employee")</td><td>@item.Date.ToShortDateString()</td><td>@item.Attendance</td><td>@item.Departure</td></tr> } }
    </tbody></table></div>
</section>

