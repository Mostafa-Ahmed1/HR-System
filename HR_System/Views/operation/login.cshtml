@model HR_System.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "login";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}



@*---------------------------------------------*@
  
        <div class="box">
          
          <div class="square" style="--i:0;"></div>
          <div class="square" style="--i:1;"></div>
          <div class="square" style="--i:2;"></div>
          <div class="square" style="--i:3;"></div>
          <div class="square" style="--i:4;"></div>
          <div class="square" style="--i:5;"></div>
          

		   
           <div class="container"> 
          <div class="form"> 
          <div class="text-center">
               <img src="~/img/logo.png" alt="company logo" width="80" >
          </div>
          

            <h2>Hr System Login </h2>
            <form asp-action="login" asp-controller="operation" method="post">
              @Html.AntiForgeryToken()
              <input asp-for="ReturnUrl" type="hidden" />
              <div asp-validation-summary="ModelOnly" class="text-danger"></div>
              <div class="inputBx">
                <input asp-for="Username" autocomplete="username" required="required">
                <span>Login</span>
              </div>


              <div class="inputBx password">
                <input id="password-input" asp-for="Password" autocomplete="current-password" required="required">
                <span>Password</span>
                <a href="#" class="password-control" onclick="return show_hide_password(this);"></a>
              </div>

              <p class="text-danger">@ViewBag.status</p>

              <label class="remember"><input asp-for="RememberMe">Remember Me </label>
              <div class="inputBx">

                <input type="submit" value="login"> 
              </div>
            </form>
             
            
          </div>
        </div>
         
          
        </div>

        

