@model IEnumerable<HR_System.Models.AttDep>


<table class="table">
    <thead>
        <tr>
            <th>
                Employee Name
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                Attendance Time
            </th>
            <th>
                Check-out Time
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @(item.Emp?.EmpName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Attendance)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Departure)
                </td>
                <td>
                    <form asp-action="Delete" asp-route-id="@item.AttId" method="post" onsubmit="return confirm('Are you sure you want to delete this attendance record?')">
                        <button type="submit" class="btn btn-danger mr-1 icon-trash">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
