@using System
@using HR_System.Models
@using HR_System.ViewModels

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString();
    var displayTitle = string.IsNullOrWhiteSpace(pageTitle) || pageTitle.Equals("Index", StringComparison.OrdinalIgnoreCase)
        ? currentController
        : pageTitle;
    var isAdmin = User.IsInRole(HrRoles.Admin);
    var userName = User.Identity?.Name;
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "U" : userName[..1].ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@displayTitle - HR System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/fonts/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/HR_System.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/img/logo.png">
</head>
<body>
    <div class="hr-shell">
        <div class="hr-sidebar-backdrop" data-hr-sidebar-close></div>

        <aside class="hr-sidebar" id="hr-sidebar" aria-label="Primary navigation">
            <div class="hr-sidebar__brand">
                <a asp-action="Index" asp-controller="Dashboard" class="hr-brand">
                    <span class="hr-brand__mark"><img src="~/img/logo.png" alt="" /></span>
                    <span>
                        <strong>HR SYSTEM</strong>
                        <small>Administration portal</small>
                    </span>
                </a>
                <button type="button" class="hr-icon-button hr-sidebar__close" data-hr-sidebar-close aria-label="Close navigation">
                    <i class="fa fa-times" aria-hidden="true"></i>
                </button>
            </div>

            <div class="hr-sidebar__section-label">Workspace</div>
            <nav class="hr-sidebar__nav">
                <a asp-action="Index" asp-controller="Dashboard" class="hr-nav-link @(currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)">
                    <i class="fa fa-th-large" aria-hidden="true"></i><span>Dashboard</span>
                </a>

                @if (ViewBag.PagesRules == null)
                {
                    <a asp-action="Index" asp-controller="Employees" class="hr-nav-link @(currentController.Equals("Employees", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-users" aria-hidden="true"></i><span>Employees</span></a>
                    <a asp-action="Index" asp-controller="Attendance" class="hr-nav-link @(currentController.Equals("Attendance", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-clock-o" aria-hidden="true"></i><span>Attendance</span></a>
                    <a asp-action="Index" asp-controller="Vacation" class="hr-nav-link @(currentController.Equals("Vacation", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-calendar" aria-hidden="true"></i><span>Vacations</span></a>
                    <a asp-action="Index" asp-controller="Salary" class="hr-nav-link @(currentController.Equals("Salary", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-bar-chart" aria-hidden="true"></i><span>Salary report</span></a>
                    <a asp-action="Index" asp-controller="User" class="hr-nav-link @(currentController.Equals("User", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-user" aria-hidden="true"></i><span>Users</span></a>
                    <a asp-action="Index" asp-controller="Group" class="hr-nav-link @(currentController.Equals("Group", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-sliders" aria-hidden="true"></i><span>Permissions</span></a>
                    <a asp-action="Index" asp-controller="Settings" class="hr-nav-link @(currentController.Equals("Settings", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-cog" aria-hidden="true"></i><span>General settings</span></a>
                }
                else
                {
                    @foreach (var rule in ViewBag.PagesRules)
                    {
                        @if (rule.PageId == 1 && rule.Read)
                        {
                            <a asp-action="Index" asp-controller="Employees" class="hr-nav-link @(currentController.Equals("Employees", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-users" aria-hidden="true"></i><span>Employees</span></a>
                        }
                        @if (rule.PageId == 2 && rule.Read)
                        {
                            <a asp-action="Index" asp-controller="Group" class="hr-nav-link @(currentController.Equals("Group", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-sliders" aria-hidden="true"></i><span>Permissions</span></a>
                        }
                        @if (rule.PageId == 3 && rule.Read)
                        {
                            <a asp-action="Index" asp-controller="User" class="hr-nav-link @(currentController.Equals("User", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-user" aria-hidden="true"></i><span>Users</span></a>
                        }
                        @if (rule.PageId == 4 && rule.Read)
                        {
                            <a asp-action="Index" asp-controller="Vacation" class="hr-nav-link @(currentController.Equals("Vacation", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-calendar" aria-hidden="true"></i><span>Vacations</span></a>
                        }
                        @if (rule.PageId == 5 && rule.Read)
                        {
                            <a asp-action="Index" asp-controller="Settings" class="hr-nav-link @(currentController.Equals("Settings", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-cog" aria-hidden="true"></i><span>General settings</span></a>
                        }
                        @if (rule.PageId == 6 && rule.Read)
                        {
                            <a asp-action="Index" asp-controller="Attendance" class="hr-nav-link @(currentController.Equals("Attendance", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-clock-o" aria-hidden="true"></i><span>Attendance</span></a>
                        }
                        @if (rule.PageId == 7 && rule.Read)
                        {
                            <a asp-action="Index" asp-controller="Salary" class="hr-nav-link @(currentController.Equals("Salary", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"><i class="fa fa-bar-chart" aria-hidden="true"></i><span>Salary report</span></a>
                        }
                    }
                }
            </nav>

            <div class="hr-sidebar__footer"><span class="hr-status-dot"></span><span>System workspace</span></div>
        </aside>

        <main class="hr-main">
            <header class="hr-topbar">
                <div class="hr-topbar__left">
                    <button type="button" class="hr-icon-button hr-menu-toggle" data-hr-sidebar-toggle aria-controls="hr-sidebar" aria-expanded="false" aria-label="Open navigation"><i class="fa fa-bars" aria-hidden="true"></i></button>
                    <div class="hr-context"><span class="hr-context__eyebrow">HR SYSTEM</span><span class="hr-context__title">@displayTitle</span></div>
                </div>
                <div class="hr-topbar__right">
                    <div class="hr-user">
                        <span class="hr-user__avatar" aria-hidden="true">@userInitial</span>
                        <span class="hr-user__details"><strong>@(userName ?? "User")</strong><small>@(isAdmin ? "Administrator" : "HR user")</small></span>
                    </div>
                    <form asp-action="logout" asp-controller="operation" method="post">
                        <button type="submit" class="hr-logout-button" aria-label="Log out"><i class="fa fa-sign-out" aria-hidden="true"></i><span>Log out</span></button>
                    </form>
                </div>
            </header>

            <div class="hr-content-area">
                <div class="hr-breadcrumb" aria-label="Breadcrumb"><span>Workspace</span><i class="fa fa-angle-right" aria-hidden="true"></i><strong>@displayTitle</strong></div>
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

