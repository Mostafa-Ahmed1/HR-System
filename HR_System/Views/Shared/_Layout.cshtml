@using System
@using HR_System.ViewModels

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var title = ViewData["Title"]?.ToString();
    var pageTitle = string.IsNullOrWhiteSpace(title) || title.Equals("Index", StringComparison.OrdinalIgnoreCase) ? controller : title;
    var userName = User.Identity?.Name;
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "U" : userName[..1].ToUpperInvariant();
    string Active(string name) => controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - HR System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/fonts/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/HR_System.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hr-sneat-overrides.css" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/img/logo.png" />
</head>
<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme" aria-label="Primary navigation">
                <div class="app-brand demo">
                    <a asp-controller="Dashboard" asp-action="Index" class="app-brand-link">
                        <span class="app-brand-logo demo"><img src="~/img/logo.png" alt="" /></span>
                        <span class="app-brand-text demo menu-text fw-bolder ms-2">HR System</span>
                    </a>
                    <button type="button" class="layout-menu-toggle menu-link text-large ms-auto d-xl-none" data-sneat-menu-toggle aria-label="Close navigation"><i class="fa fa-times" aria-hidden="true"></i></button>
                </div>
                <div class="menu-inner-shadow"></div>
                <ul class="menu-inner py-1">
                    <li class="menu-header small text-uppercase"><span class="menu-header-text">Workspace</span></li>
                    <li class="menu-item @Active("Dashboard")"><a asp-controller="Dashboard" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-th-large" aria-hidden="true"></i><div>Dashboard</div></a></li>
                    @if (ViewBag.PagesRules == null)
                    {
                        <li class="menu-item @Active("Employees")"><a asp-controller="Employees" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-users" aria-hidden="true"></i><div>Employees</div></a></li>
                        <li class="menu-item @Active("Attendance")"><a asp-controller="Attendance" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-clock-o" aria-hidden="true"></i><div>Attendance</div></a></li>
                        <li class="menu-item @Active("Vacation")"><a asp-controller="Vacation" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-calendar" aria-hidden="true"></i><div>Vacations</div></a></li>
                        <li class="menu-item @Active("Salary")"><a asp-controller="Salary" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-bar-chart" aria-hidden="true"></i><div>Salary report</div></a></li>
                        <li class="menu-item @Active("User")"><a asp-controller="User" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-user" aria-hidden="true"></i><div>Users</div></a></li>
                        <li class="menu-item @Active("Group")"><a asp-controller="Group" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-sliders" aria-hidden="true"></i><div>Permissions</div></a></li>
                        <li class="menu-item @Active("Settings")"><a asp-controller="Settings" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-cog" aria-hidden="true"></i><div>General settings</div></a></li>
                    }
                    else
                    {
                        @foreach (var rule in ViewBag.PagesRules)
                        {
                            @if (rule.PageId == 1 && rule.Read) { <li class="menu-item @Active("Employees")"><a asp-controller="Employees" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-users" aria-hidden="true"></i><div>Employees</div></a></li> }
                            @if (rule.PageId == 2 && rule.Read) { <li class="menu-item @Active("Group")"><a asp-controller="Group" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-sliders" aria-hidden="true"></i><div>Permissions</div></a></li> }
                            @if (rule.PageId == 3 && rule.Read) { <li class="menu-item @Active("User")"><a asp-controller="User" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-user" aria-hidden="true"></i><div>Users</div></a></li> }
                            @if (rule.PageId == 4 && rule.Read) { <li class="menu-item @Active("Vacation")"><a asp-controller="Vacation" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-calendar" aria-hidden="true"></i><div>Vacations</div></a></li> }
                            @if (rule.PageId == 5 && rule.Read) { <li class="menu-item @Active("Settings")"><a asp-controller="Settings" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-cog" aria-hidden="true"></i><div>General settings</div></a></li> }
                            @if (rule.PageId == 6 && rule.Read) { <li class="menu-item @Active("Attendance")"><a asp-controller="Attendance" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-clock-o" aria-hidden="true"></i><div>Attendance</div></a></li> }
                            @if (rule.PageId == 7 && rule.Read) { <li class="menu-item @Active("Salary")"><a asp-controller="Salary" asp-action="Index" class="menu-link"><i class="menu-icon fa fa-bar-chart" aria-hidden="true"></i><div>Salary report</div></a></li> }
                        }
                    }
                </ul>
                <div class="layout-menu-footer"><span class="status-dot"></span>Workspace online</div>
            </aside>

            <div class="layout-page">
                <nav class="layout-navbar navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme" aria-label="Top navigation">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none"><button type="button" class="nav-item nav-link px-0" data-sneat-menu-toggle aria-label="Open navigation" aria-controls="layout-menu" aria-expanded="false"><i class="fa fa-bars" aria-hidden="true"></i></button></div>
                    <div class="navbar-nav-right d-flex align-items-center justify-content-between w-100">
                        <div><span class="text-muted small text-uppercase fw-semibold">HR System</span><h1 class="page-context-title mb-0">@pageTitle</h1></div>
                        <div class="d-flex align-items-center gap-3"><div class="user-summary"><span class="avatar avatar-sm">@userInitial</span><span class="d-none d-sm-inline"><strong>@(userName ?? "User")</strong><small>HR workspace</small></span></div><form asp-controller="operation" asp-action="logout" method="post"><button type="submit" class="btn btn-outline-secondary btn-sm"><i class="fa fa-sign-out me-1" aria-hidden="true"></i>Log out</button></form></div>
                    </div>
                </nav>
                <main class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <nav class="breadcrumb-shell" aria-label="Breadcrumb"><span>Workspace</span><i class="fa fa-angle-right" aria-hidden="true"></i><strong>@pageTitle</strong></nav>
                        @RenderBody()
                    </div>
                    <footer class="content-footer footer bg-footer-theme"><div class="container-xxl d-flex flex-wrap justify-content-between py-2"><span>HR System</span><span class="text-muted">Internal administration</span></div></footer>
                </main>
            </div>
        </div>
        <div class="layout-overlay layout-menu-toggle" data-sneat-menu-toggle></div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

